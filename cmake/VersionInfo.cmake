# Writes <OUT> (version_info.h) from the two flat version files and the git state. Run at build time through
#   cmake -DSRC_DIR=<repo> -DOUT=<header> -P cmake/VersionInfo.cmake
# so the DLL version resources follow every commit and every edit. The header is only rewritten when its text changes,
# so an unchanged state does not recompile the resource scripts.
#
# Per component (SB = ddraw.dll, SG = SacredGear.dll): SB_VER_MAJOR/MINOR/PATCH, SB_VER_STR ("0.2.9") and
# SB_VER_FULL ("0.2.9-abc1234" or "0.2.9-abc1234-dirty"; just "0.2.9" when there is no git).

function(read_version file prefix out)
  file(STRINGS "${file}" line LIMIT_COUNT 1)
  string(STRIP "${line}" line)
  if(NOT line MATCHES "^([0-9]+)\.([0-9]+)\.([0-9]+)$")
    message(FATAL_ERROR "${file}: expected major.minor.patch, got '${line}'")
  endif()
  set(text "#define ${prefix}_VER_MAJOR ${CMAKE_MATCH_1}\n#define ${prefix}_VER_MINOR ${CMAKE_MATCH_2}\n#define ${prefix}_VER_PATCH ${CMAKE_MATCH_3}\n#define ${prefix}_VER_STR \"${line}\"\n")
  set(${out} "${text}" PARENT_SCOPE)
  set(${prefix}_STR "${line}" PARENT_SCOPE)
endfunction()

read_version("${SRC_DIR}/src/bild/SacredBild_version.txt" SB sb_text)
read_version("${SRC_DIR}/gear/SacredGear_version.txt" SG sg_text)

set(suffix "")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
    WORKING_DIRECTORY "${SRC_DIR}" OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET RESULT_VARIABLE rc)
  if(rc EQUAL 0 AND sha)
    set(suffix "-${sha}")
    # Uncommitted changes to tracked files (untracked files such as an IDE folder do not count).
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
      WORKING_DIRECTORY "${SRC_DIR}" OUTPUT_VARIABLE status ERROR_QUIET RESULT_VARIABLE rc2)
    if(rc2 EQUAL 0 AND status)
      set(suffix "${suffix}-dirty")
    endif()
  endif()
endif()

set(text "// Generated by cmake/VersionInfo.cmake at build time. Do not edit.\n#pragma once\n\n${sb_text}#define SB_VER_FULL \"${SB_STR}${suffix}\"\n\n${sg_text}#define SG_VER_FULL \"${SG_STR}${suffix}\"\n")

set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  get_filename_component(dir "${OUT}" DIRECTORY)
  file(MAKE_DIRECTORY "${dir}")
  file(WRITE "${OUT}" "${text}")
endif()
