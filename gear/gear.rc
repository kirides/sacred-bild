#include <winver.h>
#include "gear_res.h"
#include "version_info.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SG_VER_MAJOR,SG_VER_MINOR,SG_VER_PATCH,0
PRODUCTVERSION SG_VER_MAJOR,SG_VER_MINOR,SG_VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Sacred Gear mod kit for Sacred Gold"
            VALUE "FileVersion", SG_VER_STR
            VALUE "InternalName", "SacredGear"
            VALUE "OriginalFilename", "SacredGear.dll"
            VALUE "ProductName", "Sacred Gear"
            VALUE "ProductVersion", SG_VER_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The trusted Lua side of the host (lua_host.cpp loads it by this id).
IDR_GEAR_KERNEL RCDATA "lua/kernel.lua"

// The mod manager screen (Lua, loaded by the kernel as a mod of its own).
IDR_GEAR_MODMANAGER RCDATA "lua/modmanager.lua"
IDR_GEAR_LOOKUP RCDATA "lua/lookup.lua"
IDR_GEAR_FMT RCDATA "lua/fmt.lua"
IDR_GEAR_TOAST RCDATA "lua/toast.lua"
IDR_GEAR_STORE RCDATA "lua/store.lua"
IDR_GEAR_MODMANAGER_UI RCDATA "lua/modmanager.rml"
IDR_GEAR_KIT RCDATA "lua/kit.lua"
