<rml>
<head><title>Frames</title></head>
<body>
<div id="tf" class="thick-frame" data-panel="tf" data-title="Thick frame" data-dividers="160" style="position: absolute; left: 60px; top: 60px; width: 450px; height: 290px;">
    <p class="heading" style="text-align: center">Thick frame, game buttons</p>
    <div class="row" style="justify-content: center; margin-top: 24px;">
        <button id="gb-wide" class="game-button" style="width: 300px">Neuer Charakter (wide)</button>
    </div>
    <div style="position: absolute; left: 30px; top: 180px;">
        <button id="gb-narrow" class="game-button" style="min-width: 91px">OK</button>
        <button id="gb-mid" class="game-button">Logout</button>
        <button id="gb-dis" class="game-button" disabled>Disabled</button>
        <button id="gb-pad" class="game-button"><img class="padkey" src="gear:pad/a"/>Weiter</button>
    </div>
    <div style="position: absolute; left: 30px; top: 260px;">
        <button id="gb-plain" class="game-button">Weiter</button>
    </div>
</div>
<div id="pop" class="thick-frame" data-panel="pop" data-title="Popup" data-fill-inset="16 20.5 15 17.5" style="position: absolute; left: 560px; top: 60px; width: 420px; height: 190px;">
    <p style="text-align: center; font-family: 'Sacred Game'; font-size: 18px; margin-top: 6px;">Soll das Spiel beendet werden?</p>
    <div class="row" style="justify-content: center; margin-top: 18px;"><button class="game-button" style="min-width: 60px">Ok</button><button class="game-button" style="min-width: 60px">Abbrechen</button></div>
</div>
</body>
</rml>
