/* Gear theme: the classes RmlUi documents can rely on while this mod runs. Documents only override what is special.
   Palette (from the legacy gear.ui look and the Sacred Gear artwork): deep navy fills (#0e1626 .. #141c2e), gold edges
   (#c8962a, light #f0d58a, dark #6e5e3a), cyan for interactive highlights and code (#7fd0ff). */

body { font-size: 15dp; color: #e8ecf4; }

/* A window: the content box; add .title for its heading. */
.window {
    padding: 14px 16px 12px 16px;
    decorator: vertical-gradient(#e0141c2e #e00c1220);
    border: 1px #c8962a;
}
.window .title { color: #f0d58a; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; }
.muted { color: #8c8c8c; }
.accent { color: #f0d58a; }
.link, .code { color: #7fd0ff; }
.danger { color: #e05a4a; }

/* Rows: .row lays its children out side by side; .right pushes them to the right edge. */
.row { display: flex; flex-direction: row; margin: 6px 0; }
.row.right { justify-content: flex-end; }
.row.space { justify-content: space-between; }

/* Buttons (pad stops, like every button): .primary is the answer to "go ahead", .danger a destructive one. */
button {
    margin-right: 8px;
    padding: 4px 12px;
    color: #e8ecf4;
    decorator: vertical-gradient(#1a2338 #111828);
    border: 1px #6e5e3a;
    cursor: pointer;
    transition: transform 0.12s cubic-out;
}
button:hover, button:focus { decorator: vertical-gradient(#26324e #172036); border-color: #f0d58a; transform: scale(1.04); }
button:active { decorator: vertical-gradient(#111828 #1a2338); }
button.primary { border-color: #c8962a; color: #f0d58a; }
button.primary:hover, button.primary:focus { border-color: #7fd0ff; }
button.danger { border-color: #a84030; }
button:disabled { color: #8c8c8c; border-color: #3c3c3c; transform: none; }

/* Text fields. */
input.field {
    padding: 4px 8px;
    color: #e8ecf4;
    background-color: #0a101c;
    border: 1px #6e5e3a;
}
input.field:focus { border-color: #7fd0ff; }

/* Lists: .list holds .item rows; the pad moves over buttons, so make an item a button for selectable rows. */
.list { margin: 4px 0; }
.list .item { padding: 3px 8px; border-bottom: 1px #1f2a42; }

/* Bars (health, progress): <div class="bar"><div class="fill" style="width: 40%"/></div>. */
.bar { height: 10px; margin: 4px 0; background-color: #0a101c; border: 1px #6e5e3a; }
.bar .fill { height: 10px; background-color: #a82828; }
.bar.mana .fill { background-color: #2f6fd0; }
.bar.xp .fill { background-color: #c8962a; }

/* Controller prompts: <img class="padkey" src="gear:pad/a"/> inside a button; shown only while the controller was used last
   (gear sets body.pad), sized with the text. */
.padkey { display: none; width: 1.3em; height: 1.3em; margin-left: 0.5em; vertical-align: middle; }
body.pad .padkey { display: inline-block; }
