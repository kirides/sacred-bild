<rml>
<head>
    <title>RmlUi demo</title>
    <link type="text/rcss" href="demo.rcss"/>
</head>
<body>
    <div id="window">
        <!-- The corner ornaments of the game's own tooltip frame (gear.ui.native.frame): UI images 54 and 55. -->
        <img class="corner tl" src="gear:image/54"/>
        <img class="corner tr" src="gear:image/55"/>
        <img class="corner bl" src="gear:image/54?flip=v"/>
        <img class="corner br" src="gear:image/55?flip=v"/>

        <h1>RmlUi in Sacred Gear</h1>
        <p>This window is a document. The layout is HTML, the look is CSS, the buttons call Lua.</p>
        <p id="hero" class="hero">No hero yet</p>
        <div class="bar"><div id="hp" class="fill"></div></div>

        <div class="row">
            <button id="count">Clicked 0 times</button>
            <button id="reset" class="secondary">Reset</button>
            <button id="boost" class="secondary">Highlight: off</button>
        </div>
        <div class="row">
            <input id="name" class="field" type="text" value="Seraphim"/>
            <button id="greet">Greet</button>
        </div>
        <p id="greeting" class="greeting"></p>
        <div class="row right">
            <button id="close" class="secondary">Close (F6)</button>
        </div>
    </div>
</body>
</rml>
