@@ -1432,6 +1432,17 @@
 	cursor_size.x = Math::Round(ElementUtilities::GetDensityIndependentPixelRatio(text_element));
 	cursor_size.y = GetLineHeight();
 
+	// SacredBild: "caret-style: underscore" (a property Sacred Gear registers) draws the caret as a horizontal bar at the foot of the line, as wide as
+	// a "_", like the game's own text fields, instead of the thin vertical bar.
+	Vector2f cursor_offset(0, 0);
+	if (const Property* style = parent->GetProperty("caret-style"); style && style->unit == Unit::KEYWORD && style->Get<int>() == 1)
+	{
