+		cursor_offset.y = cursor_size.y - thickness;
+		cursor_size.x = Math::Max(float(ElementUtilities::GetStringWidth(text_element, "_")), 4.f);
+		cursor_size.y = thickness;
+	}
+
 	Colourb color;
