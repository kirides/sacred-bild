#pragma code_page(65001)
#include <winresrc.h>
#include "settings_window_res.h"

IDR_SETTINGS_MANIFEST RT_MANIFEST "settings_window.manifest"

// The window: tabs with one page dialog each (children of the tab control, placed in its display area).
IDD_SETTINGS DIALOGEX 0, 0, 424, 297
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "SacredBild settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 7, 7, 410, 262, WS_EX_CONTROLPARENT
    AUTOCHECKBOX    "Don't show this window again", IDC_HIDE, 7, 278, 200, 10, WS_TABSTOP
    DEFPUSHBUTTON   "Play", IDOK, 313, 276, 50, 14
    PUSHBUTTON      "Exit", IDCANCEL, 367, 276, 50, 14
END

IDD_PAGE_GENERAL DIALOGEX 0, 0, 404, 244
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Display", IDC_STATIC, 6, 4, 192, 94
    LTEXT           "Resolution:", IDC_RESOLUTION_LABEL, 14, 18, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_RESOLUTION, 84, 16, 106, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Window frame:", IDC_FRAME_LABEL, 14, 35, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_FRAME, 84, 33, 106, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Frame limit:", IDC_FPS_LIMIT_LABEL, 14, 52, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_FPS_LIMIT, 84, 50, 106, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Wait for the display's refresh (VSync)", IDC_VSYNC, 14, 68, 178, 10, WS_TABSTOP
    AUTOCHECKBOX    "Keep the mouse inside the game window", IDC_CLIP_CURSOR, 14, 81, 178, 10, WS_TABSTOP

    GROUPBOX        "Interface", IDC_STATIC, 206, 4, 192, 73
    LTEXT           "UI size:", IDC_UI_SCALE_LABEL, 214, 18, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_UI_SCALE, 284, 16, 106, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Use the UI size in the menus too", IDC_UI_SCALE_MENUS, 214, 34, 178, 10, WS_TABSTOP
    AUTOCHECKBOX    "Place the HUD windows at the screen edges", IDC_UI_ANCHOR, 214, 47, 178, 10, WS_TABSTOP
    AUTOCHECKBOX    "Smooth UI scaling (bilinear filtering)", IDC_UI_LINEAR_FILTER, 214, 60, 178, 10, WS_TABSTOP

    GROUPBOX        "Renderer", IDC_STATIC, 206, 83, 192, 47
    LTEXT           "DirectDraw:", IDC_BACKEND_LABEL, 214, 97, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_BACKEND, 284, 95, 106, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Animate characters on the GPU", IDC_GPU_SKINNING, 214, 113, 178, 10, WS_TABSTOP
END

IDD_PAGE_ADVANCED DIALOGEX 0, 0, 404, 244
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Frame timing", IDC_STATIC, 6, 4, 192, 47
    LTEXT           "In the background:", IDC_FPS_INACTIVE_LABEL, 14, 18, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_FPS_INACTIVE, 84, 16, 106, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Frames queued:", IDC_FRAME_LATENCY_LABEL, 14, 35, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_FRAME_LATENCY, 84, 33, 106, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Rendering", IDC_STATIC, 6, 57, 192, 169
    LTEXT           "Texture memory:", IDC_TEXTURE_BUDGET_LABEL, 14, 71, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_TEXTURE_BUDGET, 84, 69, 106, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Off-screen poses:", IDC_OFFSCREEN_POSES_LABEL, 14, 88, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_OFFSCREEN_POSES, 84, 86, 106, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Merge draw calls", IDC_BATCH, 14, 104, 178, 10, WS_TABSTOP
    AUTOCHECKBOX    "Let the GPU clip merged draws", IDC_BATCH_NO_CLIP, 24, 116, 168, 10, WS_TABSTOP
    AUTOCHECKBOX    "Vertex buffers for merged draws", IDC_BATCH_VERTEX_BUFFER, 24, 128, 168, 10, WS_TABSTOP
    AUTOCHECKBOX    "Merge 3D models too", IDC_BATCH_MODELS, 24, 140, 168, 10, WS_TABSTOP
    AUTOCHECKBOX    "Merge the ground's quads directly", IDC_BATCH_GROUND, 24, 152, 168, 10, WS_TABSTOP
    AUTOCHECKBOX    "Texture atlas:", IDC_ATLAS, 24, 164, 168, 10, WS_TABSTOP
    COMBOBOX        IDC_ATLAS_PAGE_SIZE, 34, 177, 48, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_ATLAS_PAGES, 86, 177, 44, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_ATLAS_MAX_TEXTURE, 134, 177, 58, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Animate on a second thread", IDC_ASYNC_ANIMATION, 14, 196, 178, 10, WS_TABSTOP
    AUTOCHECKBOX    "Hash index for the map records", IDC_RECORD_INDEX, 14, 208, 178, 10, WS_TABSTOP

    GROUPBOX        "LAN games", IDC_STATIC, 206, 4, 192, 74
    AUTOCHECKBOX    "Announce hosted games on every adapter", IDC_NET_RELAY, 214, 17, 178, 10, WS_TABSTOP
    AUTOCHECKBOX    "Send game messages right away", IDC_NET_NO_DELAY, 214, 29, 178, 10, WS_TABSTOP
    LTEXT           "Relay port:", IDC_NET_PORT_LABEL, 214, 45, 40, 8, SS_NOTIFY
    EDITTEXT        IDC_NET_PORT, 256, 43, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Join timeout (s):", IDC_NET_JOIN_TIMEOUT_LABEL, 300, 45, 58, 8, SS_NOTIFY
    EDITTEXT        IDC_NET_JOIN_TIMEOUT, 360, 43, 30, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Hosts:", IDC_NET_HOSTS_LABEL, 214, 61, 40, 8, SS_NOTIFY
    EDITTEXT        IDC_NET_HOSTS, 256, 59, 134, 12, ES_AUTOHSCROLL

    GROUPBOX        "DirectDraw", IDC_STATIC, 206, 84, 192, 58
    LTEXT           "Chain ddraw:", IDC_DDRAW_CHAIN_LABEL, 214, 98, 40, 8, SS_NOTIFY
    EDITTEXT        IDC_DDRAW_CHAIN, 256, 96, 134, 12, ES_AUTOHSCROLL
    LTEXT           "d3d9.dll:", IDC_D3D9_PATH_LABEL, 214, 114, 40, 8, SS_NOTIFY
    EDITTEXT        IDC_D3D9_PATH, 256, 112, 134, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Movies through Media Foundation", IDC_MEDIA_FOUNDATION, 214, 128, 178, 10, WS_TABSTOP

    GROUPBOX        "Screenshots and diagnostics", IDC_STATIC, 206, 148, 192, 90
    LTEXT           "Screenshots:", IDC_SCREENSHOT_FORMAT_LABEL, 214, 162, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_SCREENSHOT_FORMAT, 284, 160, 106, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Crash dumps:", IDC_CRASH_DUMP_LABEL, 214, 179, 68, 8, SS_NOTIFY
    COMBOBOX        IDC_CRASH_DUMP, 284, 177, 106, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Frame statistics", IDC_D3D_STATS, 214, 195, 86, 10, WS_TABSTOP
    AUTOCHECKBOX    "UI trace", IDC_UI_TRACE, 304, 195, 86, 10, WS_TABSTOP
    AUTOCHECKBOX    "Movie fallback", IDC_MOVIE_FALLBACK, 214, 207, 86, 10, WS_TABSTOP
    AUTOCHECKBOX    "Skinning check", IDC_SKIN_CHECK, 304, 207, 86, 10, WS_TABSTOP
    AUTOCHECKBOX    "Profiler, every", IDC_PROFILER, 214, 220, 62, 10, WS_TABSTOP
    EDITTEXT        IDC_PROFILER_INTERVAL, 278, 219, 30, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "µs", IDC_PROFILER_INTERVAL_UNIT, 311, 221, 20, 8
END

#define LAYOUT_ROW(id, text, y) \
    LTEXT text, id, 14, y + 2, 100, 8, SS_NOTIFY \
    COMBOBOX (id + 1), 120, y, 110, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP \
    COMBOBOX (id + 2), 238, y, 110, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

IDD_PAGE_LAYOUT DIALOGEX 0, 0, 404, 244
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "With ""Place the HUD windows at the screen edges"" (General tab), each in-game window's 1024 x 768 layout moves to its position below. Windows at the same position keep their original arrangement.",
                    IDC_LAYOUT_INTRO, 6, 4, 392, 26
    GROUPBOX        "Positions", IDC_STATIC, 6, 34, 392, 168
    LTEXT           "Horizontal", IDC_STATIC, 120, 48, 110, 8
    LTEXT           "Vertical", IDC_STATIC, 238, 48, 110, 8
    LAYOUT_ROW(IDC_LAYOUT_TASKBAR, "Taskbar", 60)
    LAYOUT_ROW(IDC_LAYOUT_CHAT, "Chat", 77)
    LAYOUT_ROW(IDC_LAYOUT_INVENTORY, "Inventory", 94)
    LAYOUT_ROW(IDC_LAYOUT_STATS, "Stats", 111)
    LAYOUT_ROW(IDC_LAYOUT_EQUIPMENT, "Equipment", 128)
    LAYOUT_ROW(IDC_LAYOUT_MINIMAP, "Minimap", 145)
    LAYOUT_ROW(IDC_LAYOUT_PORTRAITS, "Party portraits", 162)
    LAYOUT_ROW(IDC_LAYOUT_SHOPS, "Shops and chests", 179)
    PUSHBUTTON      "Defaults", IDC_LAYOUT_DEFAULTS, 342, 208, 56, 14
END
