#include <winver.h>
#include "version_info.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SG_VER_MAJOR,SG_VER_MINOR,SG_VER_PATCH,0
PRODUCTVERSION SG_VER_MAJOR,SG_VER_MINOR,SG_VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Sacred Gear mod kit for Sacred Gold"
            VALUE "FileVersion", SG_VER_STR
            VALUE "InternalName", "SacredGear"
            VALUE "OriginalFilename", "SacredGear.dll"
            VALUE "ProductName", "Sacred Gear"
            VALUE "ProductVersion", SG_VER_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The files embedded in the DLL, found by name: the file name in capitals with '.' as '_' (lua_host.cpp: native.builtin(name)
// finds NAME_LUA or, for a name with an extension, NAME_EXT). This list is the only one: CMake makes gear.rc depend on every
// file in lua/ and res/.
// The trusted Lua side of the host: the parts in lua/kernel.parts, joined at build time (cmake/JoinKernel.cmake).
KERNEL_LUA RCDATA "gear_kernel.lua"
// The mod manager screen (loaded by the kernel as a mod of its own) and the libraries every mod gets.
MODMANAGER_LUA RCDATA "lua/modmanager.lua"
MODMANAGER_RML RCDATA "lua/modmanager.rml"
LOOKUP_LUA RCDATA "lua/lookup.lua"
FMT_LUA RCDATA "lua/fmt.lua"
TOAST_LUA RCDATA "lua/toast.lua"
STORE_LUA RCDATA "lua/store.lua"
KIT_LUA RCDATA "lua/kit.lua"
NPC_LUA RCDATA "lua/npc.lua"
// The icon font of the mod UI (rml.cpp).
GEARICONS_TTF RCDATA "res/GearIcons.ttf"
