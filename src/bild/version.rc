#include <winver.h>
#include "version_info.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SB_VER_MAJOR,SB_VER_MINOR,SB_VER_PATCH,0
PRODUCTVERSION SB_VER_MAJOR,SB_VER_MINOR,SB_VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SacredBild ddraw hook for Sacred Gold"
            VALUE "FileVersion", SB_VER_STR
            VALUE "InternalName", "ddraw"
            VALUE "OriginalFilename", "ddraw.dll"
            VALUE "ProductName", "SacredBild"
            VALUE "ProductVersion", SB_VER_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Controller button prompts (tools/gen_prompts.py; overlay/prompts.cpp loads it by this id).
201 RCDATA "controller/prompts.png"
